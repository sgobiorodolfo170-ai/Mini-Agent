{
  "name": "miniagent",
  "version": "1.1.0",
  "description": "Windows 桌面个人 AI 助理（自用）",
  "main": "out/main/index.js",
  "author": "miniagent",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win nsis",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.mjs",
    "test:e2e:mock": "vitest run --config vitest.e2e.config.mjs --exclude \"e2e/real-provider.spec.js\"",
    "lint": "eslint src electron tests --no-warn-ignored",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "eslint": "^9.20.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "highlight.js": "^11.11.0",
    "jsdom": "^31.0.1",
    "mammoth": "^1.9.0",
    "markdown-it": "^14.1.0",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^3.0.0",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.0",
    "vitest": "^3.1.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "faiss-node": "^0.5.1",
    "onnxruntime-node": "^1.31.1"
  }
}
