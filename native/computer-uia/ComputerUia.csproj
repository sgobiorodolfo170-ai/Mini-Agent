<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>computer-uia</AssemblyName>
    <RootNamespace>ComputerUia</RootNamespace>
    <!-- The WinForms pack omits UIAutomationClient. Its WindowsBase v10 dependency conflicts with
         the .NETCore v4 forwarder at compile time; WindowsDesktop.App supplies v10 at runtime. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <Target Name="ReferenceWindowsDesktopUiAutomation" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_WindowsDesktopFrameworkReference Include="@(KnownFrameworkReference)"
          Condition="'%(Identity)' == 'Microsoft.WindowsDesktop.App' And '%(TargetFramework)' == 'net10.0'" />
      <Reference Include="UIAutomationClient">
        <HintPath>$(NetCoreTargetingPackRoot)/Microsoft.WindowsDesktop.App.Ref/%(_WindowsDesktopFrameworkReference.TargetingPackVersion)/ref/%(_WindowsDesktopFrameworkReference.TargetFramework)/UIAutomationClient.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UIAutomationTypes">
        <HintPath>$(NetCoreTargetingPackRoot)/Microsoft.WindowsDesktop.App.Ref/%(_WindowsDesktopFrameworkReference.TargetingPackVersion)/ref/%(_WindowsDesktopFrameworkReference.TargetFramework)/UIAutomationTypes.dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>
</Project>
